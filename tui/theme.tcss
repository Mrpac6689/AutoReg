/* Tema da TUI do AutoReg — paleta saúde/governo: azul petróleo + verde/âmbar
   para status, alto contraste, funciona em terminais claros e escuros. */

Screen {
    background: $surface;
}

#banner {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    height: auto;
    padding: 1 0 0 0;
}

#subtitulo {
    color: $text-muted;
    content-align: center middle;
    height: auto;
    padding: 0 0 1 0;
}

.painel {
    border: round $primary;
    padding: 1 2;
    margin: 1 2;
}

.painel-titulo {
    text-style: bold underline;
    color: $accent;
    padding-bottom: 1;
}

StatusBar {
    dock: top;
    height: auto;
    padding: 0 2;
    background: $panel;
    color: $text;
    border-bottom: solid $primary;
}

StatusBar.rodando {
    background: $warning 20%;
    color: $warning;
    text-style: bold;
}

StatusBar.ocioso-sucesso {
    color: $success;
}

StatusBar.ocioso-erro {
    color: $error;
}

#principais-grid {
    layout: grid;
    grid-size: 1;
    grid-gutter: 1;
    padding: 1 2;
    height: auto;
}

Button.principal {
    width: 100%;
    height: 3;
}

#nav-row {
    align: center middle;
    height: auto;
    padding: 1 2;
}

#nav-row Button {
    margin: 0 1;
}

.categoria-titulo {
    text-style: bold;
    color: $accent;
    padding: 1 0 0 1;
}

.cmd-row {
    height: auto;
    padding: 0 1;
}

.cmd-row Button {
    width: 14;
    margin-right: 1;
}

.cmd-desc {
    color: $text;
}

.cmd-desc.obsoleto {
    color: $text-muted;
    text-style: italic;
}

#monitor-progress {
    border: round $primary;
    padding: 1 2;
    margin: 1 2;
    height: auto;
}

#monitor-output {
    border: round $primary;
    margin: 0 2 1 2;
    height: 1fr;
}

#monitor-files {
    border: round $primary;
    margin: 0 2 1 2;
    height: auto;
    max-height: 10;
}

#monitor-controls {
    align: center middle;
    height: auto;
    padding: 0 2 1 2;
}

#monitor-controls Button {
    margin: 0 1;
}

.badge-erro {
    color: $error;
    text-style: bold;
}

.badge-ok {
    color: $success;
    text-style: bold;
}

.badge-aviso {
    color: $warning;
    text-style: bold;
}

#log-view {
    border: round $primary;
    margin: 0 2 1 2;
    height: 1fr;
}

#log-filtros {
    height: auto;
    padding: 1 2 0 2;
}

#log-filtros Input {
    width: 1fr;
}

#ajuda-body {
    padding: 1 3;
}

.hint {
    color: $text-muted;
}

/* Modais (confirmação, prompts) */
ConfirmModal, IntPromptModal, PathPromptModal {
    align: center middle;
}

#modal-box {
    width: 60;
    height: auto;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}

#modal-msg {
    padding-bottom: 1;
}

#modal-botoes {
    align: center middle;
    height: auto;
    padding-top: 1;
}

#modal-botoes Button {
    margin: 0 1;
}
